{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/stripe-webhook/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/schedules/run/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/monthly-revenue/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/signup-digest/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/schedules/run",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/monthly-revenue",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/signup-digest",
      "schedule": "0 4 * * 1"
    }
  ]
}