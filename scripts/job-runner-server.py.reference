#!/usr/bin/env python3
"""Strix job-runner daemon for AIP pentest backend.

Receives pentest jobs via HTTP, dispatches strix -n, and POSTs findings
back to the AIP callback URL on completion.
"""

import json
import os
import subprocess
import sys
import threading
import time
import uuid
from http.server import HTTPServer, BaseHTTPRequestHandler
from urllib.request import Request, urlopen
from urllib.error import URLError

STRIX_DIR = "/home/ubuntu/strix"
STRIX_BIN = "/home/ubuntu/.local/bin/strix"
STRIX_LLM = "openrouter/deepseek/deepseek-v4-flash"
LLM_API_KEY = "<redacted - lives on the box>"
HOST = "0.0.0.0"
PORT = 18992
MAX_BUDGET = 10
SECRET_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), ".secret")
JOB_RUNNER_SECRET = ""
try:
    with open(SECRET_FILE) as _f:
        JOB_RUNNER_SECRET = _f.read().strip()
except OSError:
    pass

jobs: dict[str, dict] = {}
jobs_lock = threading.Lock()


def find_latest_run(target: str, after: float) -> str | None:
    runs_dir = os.path.join(STRIX_DIR, "strix_runs")
    if not os.path.isdir(runs_dir):
        return None
    candidates = []
    for entry in os.listdir(runs_dir):
        entry_path = os.path.join(runs_dir, entry)
        if os.path.isdir(entry_path):
            mtime = os.path.getmtime(entry_path)
            if mtime > after:
                sarif = os.path.join(entry_path, "findings.sarif")
                if os.path.isfile(sarif):
                    candidates.append((mtime, entry_path))
    if not candidates:
        return None
    candidates.sort(key=lambda x: x[0], reverse=True)
    return candidates[0][1]


def read_sarif_findings(run_path: str) -> list[dict]:
    sarif_path = os.path.join(run_path, "findings.sarif")
    if not os.path.isfile(sarif_path):
        return []
    with open(sarif_path) as f:
        doc = json.load(f)
    results = []
    for run in doc.get("runs", []):
        for result in run.get("results", []):
            strix = result.get("properties", {}).get("strix", {})
            results.append({
                "title": result.get("message", {}).get("text", "").split("\n")[0],
                "description": run.get("tool", {}).get("driver", {}).get("rules", [{}])[
                    result.get("ruleIndex", 0)
                ].get("fullDescription", {}).get("text", ""),
                "poc": strix.get("poc", {}).get("description", ""),
                "impact": strix.get("impact", ""),
                "remediation": strix.get("remediation_steps", ""),
                "cvss": strix.get("cvss", 0),
                "cvssValue": str(strix.get("cvss", 0)),
                "severity": strix.get("severity", "medium"),
                "cwe": strix.get("cwe", ""),
                "endpoint": strix.get("endpoint", ""),
            })
    return results


def run_job(job: dict):
    job_id = job["id"]
    target = job["target"]
    callback_url = job.get("callbackUrl", "")
    webhook_secret = job.get("webhookSecret", "")
    pentest_id = job.get("pentestId", "")
    budget = job.get("budget", MAX_BUDGET)

    log_path = os.path.join(STRIX_DIR, f"job_{job_id}.log")
    run_tag = f"job_{job_id}"

    start_time = time.time()

    env = os.environ.copy()
    env["STRIX_LLM"] = STRIX_LLM
    env["LLM_API_KEY"] = LLM_API_KEY
    env["STRIX_TELEMETRY"] = "false"
    env["SCAN_MODE"] = "quick"

    cmd = [
        STRIX_BIN, "-n", "-m", "quick",
        "-t", target,
        "--max-budget-usd", str(budget),
    ]

    with jobs_lock:
        jobs[job_id]["status"] = "running"
        jobs[job_id]["startedAt"] = start_time

    with open(log_path, "w") as log_f:
        proc = subprocess.Popen(
            cmd,
            cwd=STRIX_DIR,
            env=env,
            stdout=log_f,
            stderr=subprocess.STDOUT,
        )
        proc.wait()

    end_time = time.time()
    exit_code = proc.returncode

    run_path = find_latest_run(target, start_time - 5)
    findings = read_sarif_findings(run_path) if run_path else []

    result = {
        "status": "completed" if exit_code == 0 else "failed",
        "pentestId": pentest_id,
        "findings": findings,
        "exitCode": exit_code,
        "duration": round(end_time - start_time, 2),
        "findingsCount": len(findings),
    }

    with jobs_lock:
        jobs[job_id]["status"] = result["status"]
        jobs[job_id]["completedAt"] = end_time
        jobs[job_id]["findings"] = findings
        jobs[job_id]["exitCode"] = exit_code

    if callback_url:
        try:
            body = json.dumps(result).encode()
            headers = {"Content-Type": "application/json"}
            if webhook_secret:
                headers["X-Webhook-Secret"] = webhook_secret
            req = Request(callback_url, data=body, headers=headers, method="POST")
            with urlopen(req, timeout=30) as resp:
                result["callbackResponse"] = resp.status
        except URLError as e:
            result["callbackError"] = str(e)

    with jobs_lock:
        jobs[job_id]["result"] = result


class JobHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        sys.stderr.write("[job-runner] %s\n" % (format % args))

    def _send_json(self, data, status=200):
        body = json.dumps(data).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        if self.path == "/jobs":
            if JOB_RUNNER_SECRET and self.headers.get("X-Job-Secret", "") != JOB_RUNNER_SECRET:
                self._send_json({"error": "unauthorized"}, 401)
                return
            length = int(self.headers.get("Content-Length", 0))
            raw = self.rfile.read(length)
            try:
                payload = json.loads(raw)
            except json.JSONDecodeError:
                self._send_json({"error": "Invalid JSON"}, 400)
                return

            target = payload.get("target", "").strip()
            if not target:
                self._send_json({"error": "target is required"}, 400)
                return

            job_id = str(uuid.uuid4())[:8]
            job = {
                "id": job_id,
                "target": target,
                "pentestId": payload.get("pentestId", ""),
                "callbackUrl": payload.get("callbackUrl", ""),
                "webhookSecret": payload.get("webhookSecret", ""),
                "budget": payload.get("budget", MAX_BUDGET),
                "status": "queued",
                "createdAt": time.time(),
            }

            with jobs_lock:
                jobs[job_id] = job

            thread = threading.Thread(target=run_job, args=(job,), daemon=True)
            thread.start()

            self._send_json({"jobId": job_id, "status": "queued"}, 202)

        elif self.path.startswith("/jobs/"):
            job_id = self.path.split("/")[2]
            with jobs_lock:
                job = jobs.get(job_id)
            if not job:
                self._send_json({"error": "job not found"}, 404)
                return
            self._send_json(job)

        else:
            self._send_json({"error": "not found"}, 404)

    def do_GET(self):
        if self.path == "/health":
            self._send_json({"status": "ok", "activeJobs": sum(
                1 for j in jobs.values() if j.get("status") in ("queued", "running")
            )})
        elif self.path.startswith("/jobs/"):
            job_id = self.path.split("/")[2]
            with jobs_lock:
                job = jobs.get(job_id)
            if not job:
                self._send_json({"error": "job not found"}, 404)
                return
            self._send_json(job)
        else:
            self._send_json({"error": "not found"}, 404)


def main():
    server = HTTPServer((HOST, PORT), JobHandler)
    print(f"[job-runner] Listening on {HOST}:{PORT}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n[job-runner] Shutting down", flush=True)
        server.server_close()


if __name__ == "__main__":
    main()
